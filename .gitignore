# All LaTeX compilation files go in build/ (only main.pdf is kept in the root;
# the completion report goes into README.md)
build/

# Safety net in case something is compiled outside of latexmk
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.lof
*.lot
*.nav
*.snm
*.vrb

# Editor / OS files (the shared VS Code settings are tracked)
.vscode/*
!.vscode/settings.json
*~
*.bak
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Figures are compiled from Figures/*.tex by latexmk
Figures/*.pdf

# Website built by site/build.py (deployed by the GitHub workflow)
_site/
__pycache__/
