#
# Rebuilds the manual before each commit and adds main.pdf and README.md (its
# Progress section) to the commit, so that the committed PDF always matches the
# committed sources. A failed build stops the commit.
# Enable once per clone with: git config core.hooksPath .githooks
# Skip it for one commit with: git commit --no-verify

if ! latexmk -silent > /dev/null; then
    echo "pre-commit: the build failed, commit stopped (see build/main.log)" >&2
    exit 1
fi
git add main.pdf README.md
