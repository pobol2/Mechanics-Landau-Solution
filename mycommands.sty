% References
\newcommand{\figref}[1]{Fig.~\ref{#1}}
\newcommand{\tabref}[1]{Tableau~\ref{#1}}
\renewcommand{\eqref}[1]{Eq.~(\ref{#1})}
\newcommand{\problemref}[1]{Problem~\ref{#1}}

% Problems are numbered within the textbook's sections: \probref{\S 9}{1}.
% Compatibility: a reference in the former chapter numbering,
% \probref{chapter}{problem}, links to the problem's textbook section and
% number (\probref{2}{3} gives "§9 Prob. 1").
\NewCommandCopy{\MechProbref}{\probref}
\newcommand*{\MechOldProblem}[3]{\@namedef{MechOld@#1-#2}{#3}}
\DeclareRobustCommand{\probref}[3][]{%
    \ifcsname MechOld@\detokenize{#2}-\detokenize{#3}\endcsname
        \expandafter\expandafter\expandafter\MechOldProbref
            \csname MechOld@\detokenize{#2}-\detokenize{#3}\endcsname{#1}%
    \else
        \MechProbref[#1]{#2}{#3}%
    \fi}
% #1 = Section, #2 = Problem, #3 = Text (or empty)
\newcommand{\MechOldProbref}[3]{\MechProbref[#3]{#1}{#2}}
