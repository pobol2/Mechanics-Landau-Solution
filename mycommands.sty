% Shortcuts
\newcommand{\ie}{\textit{i}.\textit{e}. }

% References
\renewcommand{\eqref}[1]{Eq.~(\ref{#1})}
\newcommand{\figref}[1]{Fig.~\ref{#1}}

% Math
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}
\newcommand\numberthis{\addtocounter{equation}{1}\tag{\theequation}}

% Problem titles: \texorplain{TeX}{plain text} typesets the TeX, and gives the
% plain text to the bookmarks and to the problem index (the website). Unlike
% \texorpdfstring, it is robust, so the problem index gets the plain text
% instead of the TeX. \_ is an underscore (a subscript on the website).
\DeclareRobustCommand{\texorplain}[2]{\texorpdfstring{#1}{#2}}
\ExplSyntaxOn
\text_declare_purify_equivalent:Nn \texorplain { \use_ii:nn }
\text_declare_purify_equivalent:Nn \_ { \tl_to_str:n { _ } }
\ExplSyntaxOff
